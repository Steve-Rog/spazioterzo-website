{
  // Sito pubblico. L'API, il back office e i media stanno in cloudflare/wrangler.jsonc: sono un Worker a parte.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spazioterzo-site-local",
  "main": "./workers/site.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "env": {
    "development": {
      "name": "spazioterzo-site-dev",
      "assets": {
        "directory": "./build/client",
        "binding": "ASSETS",
        "not_found_handling": "none"
      },
      "routes": [{ "pattern": "dev.spazioterzo.it", "custom_domain": true }]
    },
    "production": {
      "name": "spazioterzo-site",
      "assets": {
        "directory": "./build/client",
        "binding": "ASSETS",
        "not_found_handling": "none"
      },
      // Finché il dominio principale serve il vecchio sito, il sito nuovo vive qui con i contenuti
      // veri: il giorno del passaggio si aggiunge spazioterzo.it (e www) a questo elenco.
      "routes": [{ "pattern": "anteprima.spazioterzo.it", "custom_domain": true }]
    }
  }
}
