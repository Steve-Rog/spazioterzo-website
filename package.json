{
  "name": "spazioterzo-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "dev:worker": "wrangler dev --config cloudflare/wrangler.jsonc --local --persist-to cloudflare/.wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply spazioterzo-dev --local --config cloudflare/wrangler.jsonc --persist-to cloudflare/.wrangler/state",
    "db:migrate:dev": "wrangler d1 migrations apply spazioterzo-dev --remote --env development --config cloudflare/wrangler.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply spazioterzo-production --remote --env production --config cloudflare/wrangler.jsonc",
    "deploy:worker:dev": "npm run build:admin && wrangler deploy --keep-vars --env development --config cloudflare/wrangler.jsonc",
    "deploy:worker:production": "npm run build:admin && wrangler deploy --keep-vars --env production --config cloudflare/wrangler.jsonc",
    "dev:admin": "vite --config admin/vite.config.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "typecheck:admin": "tsc -p admin/tsconfig.json",
    "typecheck:worker": "tsc -p cloudflare/tsconfig.json",
    "test": "vitest run",
    "build:site:dev": "CLOUDFLARE_ENV=development VITE_CONTENT_API_URL=https://api.dev.spazioterzo.it react-router build",
    "deploy:site:dev": "npm run build:site:dev && wrangler deploy --config build/server/wrangler.json",
    "content:prod-to-dev": "node cloudflare/scripts/copia-contenuti.mjs --da production --a development",
    "content:dev-to-prod": "node cloudflare/scripts/copia-contenuti.mjs --da development --a production",
    "build:site:prod": "CLOUDFLARE_ENV=production VITE_CONTENT_API_URL=https://api.spazioterzo.it react-router build",
    "deploy:site:prod": "npm run build:site:prod && wrangler deploy --config build/server/wrangler.json"
  },
  "dependencies": {
    "@mantine/core": "^9.5.2",
    "@mantine/dropzone": "^9.5.2",
    "@mantine/form": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "@mantine/tiptap": "^9.5.2",
    "@tabler/icons-react": "^3.46.0",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "framer-motion": "^13.1.1",
    "isbot": "^5.2.1",
    "jose": "^6.2.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@cloudflare/workers-types": "5.20260826.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.3.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
