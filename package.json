{
  "name": "spazioterzo-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc",
    "dev:worker": "wrangler dev --config cloudflare/wrangler.jsonc --local",
    "db:migrate:local": "wrangler d1 migrations apply spazioterzo-dev --local --config cloudflare/wrangler.jsonc",
    "db:migrate:dev": "wrangler d1 migrations apply spazioterzo-dev --remote --env development --config cloudflare/wrangler.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply spazioterzo-production --remote --env production --config cloudflare/wrangler.jsonc",
    "deploy:worker:dev": "wrangler deploy --keep-vars --env development --config cloudflare/wrangler.jsonc",
    "deploy:worker:production": "wrangler deploy --keep-vars --env production --config cloudflare/wrangler.jsonc",
    "dev:admin": "vite --config admin/vite.config.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "typecheck:worker": "tsc -p cloudflare/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mantine/core": "^9.5.2",
    "@mantine/dropzone": "^9.5.2",
    "@mantine/form": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "@mantine/tiptap": "^9.5.2",
    "@react-router/node": "^7.18.2",
    "@tabler/icons-react": "^3.46.0",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@vercel/react-router": "^1.3.4",
    "framer-motion": "^13.1.1",
    "isbot": "^5.2.1",
    "jose": "^6.2.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260826.1",
    "@react-router/dev": "^7.18.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.126.0"
  }
}
