{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "spazioterzo-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_MEDIA_BASE_URL": "http://localhost:8787/media"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spazioterzo-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "spazioterzo-media-dev" }],
  "env": {
    "production": {
      "name": "spazioterzo-api",
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_MEDIA_BASE_URL": "https://media.example.org"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "spazioterzo-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "spazioterzo-media-production" }]
    }
  }
}
