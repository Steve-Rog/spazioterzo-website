{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "spazioterzo-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "ENVIRONMENT": "local",
    "PUBLIC_MEDIA_BASE_URL": "http://localhost:8787/media"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spazioterzo-dev",
      "database_id": "61e33bf0-cd38-485d-a123-7c67830eb1e8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "spazioterzo-media-dev" }],
  "env": {
    "development": {
      "name": "spazioterzo-api-dev",
      "assets": {
        "directory": "../admin/dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "single-page-application"
      },
      "routes": [
        { "pattern": "admin.dev.spazioterzo.it", "custom_domain": true },
        { "pattern": "api.dev.spazioterzo.it", "custom_domain": true },
        { "pattern": "media.dev.spazioterzo.it", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        "PUBLIC_MEDIA_BASE_URL": "https://media.dev.spazioterzo.it/media",
        "PUBLIC_API_BASE_URL": "https://api.dev.spazioterzo.it",
        "ADMIN_ORIGIN": "https://admin.dev.spazioterzo.it"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "spazioterzo-dev",
          "database_id": "61e33bf0-cd38-485d-a123-7c67830eb1e8",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "spazioterzo-media-dev" }]
    },
    "production": {
      "name": "spazioterzo-api",
      "assets": {
        "directory": "../admin/dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "single-page-application"
      },
      "routes": [
        { "pattern": "admin.spazioterzo.it", "custom_domain": true },
        { "pattern": "api.spazioterzo.it", "custom_domain": true },
        { "pattern": "media.spazioterzo.it", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_MEDIA_BASE_URL": "https://media.spazioterzo.it/media",
        "PUBLIC_API_BASE_URL": "https://api.spazioterzo.it",
        "ADMIN_ORIGIN": "https://admin.spazioterzo.it"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "spazioterzo-production",
          "database_id": "736d29ce-db34-48aa-aabc-16cfdbbfb453",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "spazioterzo-media-production" }]
    }
  }
}
